<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUIProfiles>

    <!-- History list container (top-aligned, matches ASC pattern) -->
    <Profile name="rmNegHistoryList" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft">
    </Profile>

    <!-- History list row: 32px, FS25 standard alternating dark grey -->
    <Profile name="rmNegHistoryListItem" extends="baseReference" with="anchorTopStretchingX">
        <height value="32px"/>
        <imageSliceId value="gui.empty"/>
        <imageColor value="0.10 0.10 0.10 1"/>
        <alternateBackgroundColor value="$preset_colorTransparent"/>
    </Profile>

    <!-- Round column (R1, R2)  - dimmed, center-aligned, 15px -->
    <Profile name="rmNegRoundText" extends="fs25_textDefault" with="anchorStretchingYLeft">
        <width value="50px"/>
        <textAlignment value="center"/>
        <textColor value="$preset_colorWhite_50"/>
        <textSelectedColor value="$preset_colorWhite_50"/>
    </Profile>

    <!-- Party column (You, Seller)  - standard list text, 15px -->
    <Profile name="rmNegPartyText" extends="fs25_textDarkHighlight" with="anchorStretchingYLeft">
        <width value="140px"/>
        <textSelectedColor value="$preset_fs25_colorMainLight"/>
    </Profile>

    <!-- Amount column (€ 85,000)  - bold, right-aligned, green highlight, 16px -->
    <Profile name="rmNegAmountText" extends="fs25_textDarkHighlight" with="anchorStretchingYLeft">
        <width value="390px"/>
        <textSize value="16px"/>
        <textBold value="true"/>
        <textAlignment value="right"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
        <textSelectedColor value="$preset_fs25_colorMainHighlight"/>
    </Profile>

    <!-- Status text area  - centered, 16px (matches fs25_dialogText) -->
    <Profile name="rmNegStatusText" extends="fs25_textDefault" with="anchorTopLeft">
        <textSize value="16px"/>
        <textAlignment value="center"/>
        <textVerticalAlignment value="middle"/>
    </Profile>

    <!-- Header info text  - dimmed secondary info, 15px, centered -->
    <Profile name="rmNegHeaderInfo" extends="fs25_textDefault" with="anchorTopLeft">
        <textColor value="$preset_colorWhite_50"/>
        <textAlignment value="center"/>
    </Profile>

    <!-- Secondary button (MENU_EXTRA_1 input action)  - not a global FS25 profile -->
    <Profile name="buttonExtra1" extends="buttonOK">
        <inputAction value="MENU_EXTRA_1"/>
    </Profile>

    <!-- Text input for offer amounts  - light text on dark dialog bg -->
    <Profile name="rmNegTextInput" extends="fs25_textInput" with="anchorTopLeft">
        <textBold value="true"/>
        <textSize value="16px"/>
        <textColor value="$preset_fs25_colorMainLight"/>
    </Profile>

    <!-- =================================================================
         Watchlist row profiles (used by RmWatchlistDialog.xml)
         Mirrors the AdjustStorageCapacity rmAscFillType* shape:
         55px alternating-bg row, primary text, dim secondary text,
         right-aligned price/status whose colour the populator sets
         imperatively from RmFarmlandMarket.COLOR_WATCHLIST_*.
         ================================================================= -->

    <!-- Watchlist list container -->
    <Profile name="rmFmWatchlistList" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft">
    </Profile>

    <!-- Watchlist row (alternating bg driven by the engine via 'alternating') -->
    <Profile name="rmFmWatchlistRow" extends="baseReference" with="anchorTopStretchingX alternating">
        <height value="55px"/>
        <imageColor value="$preset_fs25_colorGrey"/>
        <imageSelectedColor value="$preset_fs25_colorMainHighlight"/>
        <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50"/>
    </Profile>

    <!-- Watchlist primary text (farmland name) -->
    <Profile name="rmFmWatchlistName" extends="baseReference" with="anchorTopLeft">
        <textBold value="false"/>
        <textSize value="18px"/>
        <textAlignment value="left"/>
        <textColor value="$preset_fs25_colorMainLight"/>
        <textSelectedColor value="$preset_fs25_colorMainDark"/>
    </Profile>

    <!-- Watchlist secondary text (area + expiry suffix) -->
    <Profile name="rmFmWatchlistSubtext" extends="baseReference" with="anchorTopLeft">
        <textBold value="false"/>
        <textSize value="13px"/>
        <textAlignment value="left"/>
        <textColor value="$preset_colorWhite_50"/>
        <textSelectedColor value="$preset_fs25_colorMainDark"/>
    </Profile>

    <!-- Watchlist right column (price or 'Not for sale')
         The textColor is overwritten per-row by populateCellForItemInSection
         so the same profile can render both palettes; the value here is just
         a sane default before the first populator pass. -->
    <Profile name="rmFmWatchlistPrice" extends="baseReference" with="anchorStretchingYLeft">
        <textBold value="true"/>
        <textSize value="16px"/>
        <textAlignment value="right"/>
        <textColor value="$preset_fs25_colorMainHighlight"/>
        <textSelectedColor value="$preset_fs25_colorMainDark"/>
    </Profile>

    <!-- Settings button for price/ha input (based on RL rl_settingsButton pattern) -->
    <Profile name="rmFmSettingsButton" extends="emptyPanel" with="anchorMiddleRight">
        <size value="280px 32px"/>
        <position value="-10px 0px"/>
        <focusOnHighlight value="true"/>
        <textResizeWidth value="200px"/>
        <textSize value="16px"/>
        <iconColor value="$preset_colorTransparent"/>
        <iconFocusedColor value="$preset_colorTransparent"/>
        <iconTextOffset value="0px -1px"/>
        <iconHighlightedColor value="$preset_colorTransparent"/>
        <textBold value="true"/>
        <textUpperCase value="true"/>
        <textAlignment value="center"/>
        <textColor value="$preset_fs25_colorMainLight"/>
        <textFocusedColor value="$preset_fs25_colorMainDark"/>
        <textDisabledColor value="$preset_colorDisabled"/>
    </Profile>

</GUIProfiles>
